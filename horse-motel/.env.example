# Copy to .env and fill in. Never commit .env.

# ── Site ─────────────────────────────────────────────
NODE_ENV=production
# The public https address guests use. Must be https in production.
APP_ORIGIN=https://book.example.com
PORT=3000
HOST=127.0.0.1
# How many reverse proxies sit in front of the app (Caddy/nginx = 1). Used for real client IPs.
TRUST_PROXY=1
# Encrypts 2-step secrets and camera addresses in the database. Generate once and keep a
# copy somewhere safe (without it, those can't be read back):  openssl rand -base64 32
DATA_KEY=

RANCH_NAME=Rockin' C Ranch
RANCH_TZ=America/Chicago
# Shown in the footer of every page and in emails. At least one is required in production.
RANCH_CONTACT_EMAIL=
RANCH_CONTACT_PHONE=
RANCH_ADDRESS=Lonoke, Arkansas
RANCH_LAT=34.863750
RANCH_LNG=-91.916582
# The hero shows your rating and links to the reviews. RATING= (empty) hides it.
RATING=5.0
REVIEW_COUNT=8
REVIEW_URL=https://www.airbnb.com/rooms/1711664297060154728#reviews
# Shown on the policies page and in the FAQ. Write your own!
CANCELLATION_POLICY=
CHECK_IN_HOUR=15
CHECK_OUT_HOUR=11

# ── Inventory ────────────────────────────────────────
STALL_COUNT=8
RV_SITE_COUNT=6
# The first N RV sites also have sewer ("full hookup").
RV_SEWER_SITES=2
HOUSE_MAX_GUESTS=6
MAX_NIGHTS=28
BOOKING_WINDOW_DAYS=365

# ── Prices, in CENTS (17500 = $175.00). These defaults are placeholders: set yours. ──
CURRENCY=usd
PRICE_HOUSE_NIGHT_CENTS=17500
PRICE_STALL_NIGHT_CENTS=3500
PRICE_RV_NIGHT_CENTS=4500
PRICE_RV_SEWER_NIGHT_CENTS=5500
PRICE_HOUSE_CLEANING_CENTS=7500
PRICE_STALL_CLEANING_CENTS=1000
# Optional tax line, in basis points (1150 = 11.5%). Check what applies to you.
TAX_BASIS_POINTS=0
TAX_LABEL=Taxes

# ── Payments (Stripe) ────────────────────────────────
PAYMENTS_MODE=stripe
# Restricted keys are fine: needs Checkout Sessions (write) and read access to Events.
STRIPE_SECRET_KEY=sk_live_...
# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (guests are onboarded by email) ────────────
# e.g. smtps://USER:PASSWORD@smtp.postmarkapp.com:465  (smtp:// on port 587 also works:
# the server then insists on STARTTLS and refuses to send unencrypted)
SMTP_URL=
MAIL_FROM=Rockin' C Ranch <bookings@example.com>
# Where new-booking and "needs attention" alerts go. Required in production.
ADMIN_ALERT_EMAIL=

# ── Airbnb calendar sync ─────────────────────────────
# Airbnb → Calendar → Availability → Connect calendars → Export: paste that link here.
# Airbnb reservations then block the house here (ICAL_BLOCKS), and cancelled ones free it.
ICAL_IMPORT_URLS=
ICAL_BLOCKS=house
ICAL_SYNC_MINUTES=30
# A long random value (openssl rand -hex 24). Airbnb imports your bookings from
#   https://<your site>/calendar/<ICAL_EXPORT_TOKEN>.ics   (Admin → Sync & security shows it)
ICAL_EXPORT_TOKEN=

# ── Cameras ──────────────────────────────────────────
# Comma-separated host names/IPs the server may fetch camera video from (required in
# production): a camera address can never be pointed anywhere else. With the recommended
# setup (MediaMTX on this server, see cameras/README.md) this is 127.0.0.1.
CAMERA_ALLOWED_HOSTS=127.0.0.1
CAMERA_HOURS_BEFORE_CHECKIN=3
CAMERA_HOURS_AFTER_CHECKOUT=2

# ── Sessions ─────────────────────────────────────────
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=168
